# Publish only maintained source, docs, and reproducible build inputs.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/HANDOFF-*.md
!/CHECKLIST-*.md
!/CONTINUE.md
!/PLAN.md
!/EXPORT-README.md
!/RELEASE-*.md
!/OPERIT-*.md
!/dev-run-bridge.ps1
!/bridge/
!/docs/
!/test/
!/tooling/
!/device/
!/web/
!/dsh-host/
!/dshgo-fork/

# Local SDKs, credentials, user data, diagnostics and generated artifacts.
